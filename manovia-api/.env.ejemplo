# Copiá este archivo como .env para desarrollo local.
# En Railway estas variables se cargan en la pestaña Variables.

# Railway la inyecta sola al vincular el servicio MySQL.
# Para local con Workbench, usá MYSQLHOST / MYSQLUSER / etc.
MYSQL_URL=mysql://root:clave@containers-us-west-1.railway.app:6543/railway

# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dominios que pueden consumir el API, separados por coma
ORIGENES=https://manovia.com.ar,https://www.manovia.com.ar,https://manovia.vercel.app

# Carpeta del volumen de Railway. En local podés usar ./fotos
CARPETA_FOTOS=/data/fotos
